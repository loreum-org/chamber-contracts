{
  "name": "@loreum/chamber-operator",
  "version": "0.1.0",
  "private": true,
  "description": "Typed Chamber operator surface for agents: board, quorum, delegate, submit, confirm, execute, session-key operator.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "chamber-operator": "./bin/chamber-operator.mjs"
  },
  "scripts": {
    "chamber-operator": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "example:anvil": "tsx examples/anvil-e2e.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
